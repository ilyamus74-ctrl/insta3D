<?php
declare(strict_types=1);

require_once __DIR__ . '/bootstrap.php';

auth_require_login();

$user = auth_current_user();
$userId = (int)$user['id'];
$role = $user['role'] ?? 'BROKER';

$path = (string)($_GET['path'] ?? '');
$path = trim($path);

if ($path === '') {
    http_response_code(400);
    exit('Missing path');
}

// Normalize URL-decoded path.
$path = str_replace('\\', '/', $path);
$path = ltrim($path, '/');

// Only storage/order media is allowed.
if (!preg_match('~^orders/([0-9]+)/~', $path, $m)) {
    http_response_code(400);
    exit('Bad media path');
}

$orderId = (int)$m[1];

function maklertour_can_view_order_media(array $order, int $userId, string $role): bool {
    return $role === 'ADMIN'
        || ((int)$order['broker_id'] === $userId)
        || (
            $role === 'OPERATOR'
            && (
                (int)$order['operator_id'] === $userId
                || (
                    (int)$order['is_published'] === 1
                    && (string)$order['status'] === 'NEW'
                    && $order['operator_id'] === null
                )
            )
        );
}

function maklertour_load_order_for_media(mysqli $dbcnx, int $orderId): ?array {
    $stmt = $dbcnx->prepare("
        SELECT *
        FROM tour_orders
        WHERE id = ?
        LIMIT 1
    ");

    if (!$stmt) {
        return null;
    }

    $stmt->bind_param('i', $orderId);
    $stmt->execute();
    $order = $stmt->get_result()->fetch_assoc() ?: null;
    $stmt->close();

    return $order;
}

$order = maklertour_load_order_for_media($dbcnx, $orderId);

if (!$order) {
    http_response_code(404);
    exit('Order not found');
}

$canView = maklertour_can_view_order_media($order, $userId, $role);

function maklertour_media_candidate_paths(string $path): array {
    $paths = [$path];

    foreach (['viewer', 'viewer_light', 'viewer_hd', 'previews', 'raw_dualfisheye'] as $variant) {
        $needle = '/photos/' . $variant . '/';
        if (strpos($path, $needle) !== false) {
            $paths[] = str_replace($needle, '/photos/originals/', $path);
        }
    }

    return array_values(array_unique(array_filter($paths, static fn($v) => is_string($v) && $v !== '')));
}

function maklertour_load_order_by_stored_media_path(mysqli $dbcnx, string $path): ?array {
    $candidates = maklertour_media_candidate_paths($path);
    if (!$candidates) {
        return null;
    }

    $placeholders = implode(',', array_fill(0, count($candidates), '?'));

    $sql = "
        SELECT o.*
        FROM photo_points pp
        JOIN capture_sessions cs ON cs.id = pp.session_id
        JOIN tour_orders o ON o.id = cs.order_id
        WHERE cs.deleted_at IS NULL
          AND pp.deleted_at IS NULL
          AND COALESCE(pp.upload_state,'') <> 'DELETED'
          AND (
              pp.preview_storage_path IN ($placeholders)
              OR pp.original_storage_path IN ($placeholders)
          )
        ORDER BY pp.id DESC
        LIMIT 1
    ";

    $stmt = $dbcnx->prepare($sql);
    if ($stmt) {
        $types = str_repeat('s', count($candidates) * 2);
        $params = array_merge($candidates, $candidates);
        $stmt->bind_param($types, ...$params);
        $stmt->execute();
        $order = $stmt->get_result()->fetch_assoc() ?: null;
        $stmt->close();

        if ($order) {
            return $order;
        }
    }

    $stmt = $dbcnx->prepare("
        SELECT o.*
        FROM video_scans vs
        JOIN capture_sessions cs ON cs.id = vs.session_id
        JOIN tour_orders o ON o.id = cs.order_id
        WHERE cs.deleted_at IS NULL
          AND vs.deleted_at IS NULL
          AND COALESCE(vs.upload_state,'') <> 'DELETED'
          AND vs.storage_path = ?
        ORDER BY vs.id DESC
        LIMIT 1
    ");

    if ($stmt) {
        $stmt->bind_param('s', $path);
        $stmt->execute();
        $order = $stmt->get_result()->fetch_assoc() ?: null;
        $stmt->close();

        if ($order) {
            return $order;
        }
    }

    return null;
}

/*
 * Fallback access by DB media ownership.
 * If path starts with orders/<old_id>/ but the file belongs to a photo/video row
 * attached to another capture_session/order, authorize by that real order.
 */
if (!$canView) {
    $realOrder = maklertour_load_order_by_stored_media_path($dbcnx, $path);
    if ($realOrder && maklertour_can_view_order_media($realOrder, $userId, $role)) {
        $canView = true;
    }
}

/*
 * Last fallback by app_session_uuid from path.
 */
if (!$canView && preg_match('~^orders/[0-9]+/sessions/([^/]+)/~', $path, $sm)) {
    $appSessionUuid = (string)$sm[1];

    $stmt = $dbcnx->prepare("
        SELECT o.*
        FROM capture_sessions cs
        JOIN tour_orders o ON o.id = cs.order_id
        WHERE cs.app_session_uuid = ?
          AND cs.deleted_at IS NULL
        ORDER BY cs.id DESC
        LIMIT 1
    ");

    if ($stmt) {
        $stmt->bind_param('s', $appSessionUuid);
        $stmt->execute();
        $realOrder = $stmt->get_result()->fetch_assoc() ?: null;
        $stmt->close();

        if ($realOrder && maklertour_can_view_order_media($realOrder, $userId, $role)) {
            $canView = true;
        }
    }
}

if (!$canView) {
    error_log('MEDIA_FORBIDDEN path=' . $path . ' user_id=' . $userId . ' role=' . $role . ' path_order_id=' . $orderId);
    http_response_code(403);
    exit('Forbidden');
}

$storageRoot = defined('APP_STORAGE_DIR')
    ? APP_STORAGE_DIR
    : dirname(__DIR__) . '/storage';

$storageRootReal = realpath($storageRoot);

if ($storageRootReal === false) {
    http_response_code(500);
    exit('Storage root missing');
}

$fullPath = $storageRootReal . '/' . $path;
$fileReal = realpath($fullPath);

if (
    $fileReal === false
    || strpos($fileReal, $storageRootReal . DIRECTORY_SEPARATOR) !== 0
    || !is_file($fileReal)
) {
    http_response_code(404);
    exit('File not found');
}

$ext = strtolower((string)pathinfo($fileReal, PATHINFO_EXTENSION));

$contentType = match ($ext) {
    'jpg', 'jpeg' => 'image/jpeg',
    'png' => 'image/png',
    'webp' => 'image/webp',
    'gif' => 'image/gif',
    'mp4' => 'video/mp4',
    'mov' => 'video/quicktime',
    default => 'application/octet-stream',
};

clearstatcache(true, $fileReal);

$size = filesize($fileReal);
if ($size === false || $size < 0) {
    http_response_code(500);
    exit('Cannot read file size');
}

$start = 0;
$end = $size - 1;
$statusCode = 200;

$rangeHeader = $_SERVER['HTTP_RANGE'] ?? '';

if ($rangeHeader !== '') {
    if (preg_match('/bytes=(\d*)-(\d*)/i', (string)$rangeHeader, $r)) {
        if ($r[1] !== '') {
            $start = (int)$r[1];
        }

        if ($r[2] !== '') {
            $end = (int)$r[2];
        }

        if ($r[1] === '' && $r[2] !== '') {
            $suffix = (int)$r[2];
            if ($suffix > 0) {
                $start = max(0, $size - $suffix);
                $end = $size - 1;
            }
        }

        if ($start > $end || $start >= $size) {
            while (ob_get_level() > 0) {
                ob_end_clean();
            }

            header('Content-Range: bytes */' . $size);
            http_response_code(416);
            exit;
        }

        $end = min($end, $size - 1);
        $statusCode = 206;
    }
}

$length = $end - $start + 1;

// Critical: remove any output generated by bootstrap/session/smarty/warnings.
// Binary media response must start exactly with file bytes.
while (ob_get_level() > 0) {
    ob_end_clean();
}

ini_set('zlib.output_compression', '0');

http_response_code($statusCode);
header('Content-Type: ' . $contentType);
header('Content-Disposition: inline; filename="' . basename($fileReal) . '"');
header('X-Content-Type-Options: nosniff');
header('Accept-Ranges: bytes');
header('Cache-Control: private, max-age=3600');
header('Content-Length: ' . $length);

if ($statusCode === 206) {
    header('Content-Range: bytes ' . $start . '-' . $end . '/' . $size);
}

if ($_SERVER['REQUEST_METHOD'] === 'HEAD') {
    exit;
}

$fp = fopen($fileReal, 'rb');
if ($fp === false) {
    http_response_code(500);
    exit;
}

if ($start > 0) {
    fseek($fp, $start);
}

$remaining = $length;

while ($remaining > 0 && !feof($fp)) {
    $read = min(1024 * 1024, $remaining);
    $buffer = fread($fp, $read);

    if ($buffer === false || $buffer === '') {
        break;
    }

    echo $buffer;
    flush();

    $remaining -= strlen($buffer);
}

fclose($fp);
exit;
