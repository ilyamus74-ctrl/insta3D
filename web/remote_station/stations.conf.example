# Station key/name used in logs and CLI output.
STATION_NAME="grafikstation01"

# WireGuard/private IP or hostname of the GPU station.
STATION_HOST="10.77.0.2"
STATION_USER="root"
STATION_SSH_KEY="/root/.ssh/id_ed25519"

# Remote working directory on GPU station.
STATION_BASE="/home/makler_storage"

# Install missing station packages during install_station.sh (1=yes, 0=check only).
INSTALL_PACKAGES="1"

# Fail install_station.sh if COLMAP is unavailable after package installation/checks.
REQUIRE_COLMAP="1"