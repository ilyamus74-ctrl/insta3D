# Station key/name used in logs and CLI output.
STATION_NAME="grafikstation01"

# WireGuard/private IP or hostname of the GPU station.
STATION_HOST="10.77.0.2"
STATION_USER="root"
STATION_SSH_KEY="/root/.ssh/id_ed25519"

# Remote working directory on GPU station.
STATION_BASE="/home/makler_storage"

# Install missing station packages during install_station.sh (1=yes, 0=check only).
INSTALL_PACKAGES="1"

# Fail install_station.sh if COLMAP is unavailable after package installation/checks.
COLMAP_MODE="podman"
COLMAP_BIN="colmap"
COLMAP_IMAGE="docker.io/colmap/colmap:latest"
COLMAP_MATCHER="sequential"
COLMAP_SEQUENTIAL_OVERLAP="10"
REQUIRE_COLMAP="1"
# Chunked COLMAP dense reconstruction defaults.
COLMAP_PREVIEW_MAX_IMAGE_SIZE="640"
COLMAP_PREVIEW_PATCHMATCH_CACHE_SIZE="2"
COLMAP_PREVIEW_FUSION_CACHE_SIZE="2"
COLMAP_PREVIEW_NUM_SRC_IMAGES="6"
COLMAP_PREVIEW_TARGET_IMAGES_PER_CHUNK="50"
COLMAP_PREVIEW_MAX_IMAGES_PER_CHUNK="80"
COLMAP_PREVIEW_OVERLAP_IMAGES="15"
COLMAP_PREVIEW_RAM_RESERVE_MB="3000"
COLMAP_HQ_MAX_IMAGE_SIZE="1600"
COLMAP_HQ_PATCHMATCH_CACHE_SIZE="4"
COLMAP_HQ_FUSION_CACHE_SIZE="4"
COLMAP_HQ_NUM_SRC_IMAGES="8"
COLMAP_HQ_TARGET_IMAGES_PER_CHUNK="60"
COLMAP_HQ_MAX_IMAGES_PER_CHUNK="100"
COLMAP_HQ_OVERLAP_IMAGES="20"
COLMAP_HQ_RAM_RESERVE_MB="3000"
COLMAP_MAX_PARALLEL_DENSE_CHUNKS="1"
